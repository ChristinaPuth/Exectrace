# Copy this file to .env and fill in your keys. .env is gitignored.
# The chat needs ONE of the two LLM keys. Collection can use both.

OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: web search during collection. Without it the pipeline uses the
# company site, SEC EDGAR and Wikipedia only.
TAVILY_API_KEY=

# Needed only for SEC EDGAR during collection. The SEC asks automated clients
# to identify themselves, e.g. "Your Name your.email@example.com".
SEC_USER_AGENT=

# Optional overrides of config.toml [models]
# CHAT_PROVIDER=openai
# CHAT_MODEL=
# EXTRACT_PROVIDER=groq
# EXTRACT_MODEL=
